@model ServiceApresVenteApp.Models.Intervention
@{
    ViewData["Title"] = "Delete Intervention";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <h2>Delete Intervention</h2>
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this intervention?</h4>
        <p>This will also delete all associated spare parts. This action cannot be undone.</p>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5>Intervention Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>
                
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
                
                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.InterventionDate.ToShortDateString()</dd>
                
                <dt class="col-sm-3">Labor Cost</dt>
                <dd class="col-sm-9">@Model.LaborCost.ToString("C")</dd>
                
                <dt class="col-sm-3">Is Free (Under Warranty)</dt>
                <dd class="col-sm-9">
                    @if (Model.IsFree)
                    {
                        <span class="badge bg-success">Yes (Free)</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No (Paid)</span>
                    }
                </dd>
                
                <dt class="col-sm-3">Complaint</dt>
                <dd class="col-sm-9">Complaint #@Model.ComplaintId</dd>
                
                <dt class="col-sm-3">Client</dt>
                <dd class="col-sm-9">@Model.Complaint?.Client?.Name</dd>
                
                <dt class="col-sm-3">Article</dt>
                <dd class="col-sm-9">@Model.Complaint?.Article?.Name</dd>
            </dl>
        </div>
    </div>
    
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("Index", "Interventions")" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
