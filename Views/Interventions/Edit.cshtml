@model ServiceApresVenteApp.Models.Intervention
@{
    ViewData["Title"] = "Edit Intervention";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <h2>Edit Intervention</h2>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ComplaintId" />
        
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="InterventionDate" class="form-label">Intervention Date</label>
            <input asp-for="InterventionDate" class="form-control" type="date" />
            <span asp-validation-for="InterventionDate" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="LaborCost" class="form-label">Labor Cost</label>
            <input asp-for="LaborCost" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="LaborCost" class="text-danger"></span>
        </div>
        
        <div class="mb-3 form-check">
            <input asp-for="IsFree" class="form-check-input" id="isFreeCheck" />
            <label asp-for="IsFree" class="form-check-label">Is Free (Under Warranty)</label>
        </div>
        
        <div class="mb-3">
            <p><strong>Complaint:</strong> #@Model.ComplaintId - @Model.Complaint?.Description</p>
            <p><strong>Client:</strong> @Model.Complaint?.Client?.Name</p>
            <p><strong>Article:</strong> @Model.Complaint?.Article?.Name</p>
        </div>
        
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="@Url.Action("Index", "Interventions")" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>