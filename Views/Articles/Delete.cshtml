@model ServiceApresVenteApp.Models.Article
@{
    ViewData["Title"] = "Delete Article";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <h2>Delete Article</h2>
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this article?</h4>
        <p>This action cannot be undone.</p>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5>Article Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>
                
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
                
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
                
                <dt class="col-sm-3">Warranty (Months)</dt>
                <dd class="col-sm-9">@Model.WarrantyMonths</dd>
                
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">@Model.Price.ToString("C")</dd>
                
                <dt class="col-sm-3">Purchase Date</dt>
                <dd class="col-sm-9">@Model.PurchaseDate.ToShortDateString()</dd>
                
                <dt class="col-sm-3">Warranty Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsUnderWarranty())
                    {
                        <span class="badge bg-success">Under Warranty</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Out of Warranty</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
    
    <form method="post" action="@Url.Action("Delete", "Articles", new { id = Model.Id })">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("Index", "Articles")" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

