@model ServiceApresVenteApp.Models.Complaint
@{
    ViewData["Title"] = "Delete Complaint";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <h2>Delete Complaint</h2>
    
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this complaint?</h4>
        <p>This will also delete all associated interventions and spare parts. This action cannot be undone.</p>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5>Complaint Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>
                
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
                
                <dt class="col-sm-3">Submission Date</dt>
                <dd class="col-sm-9">@Model.SubmissionDate.ToShortDateString()</dd>
                
                <dt class="col-sm-3">Client</dt>
                <dd class="col-sm-9">@Model.Client?.Name</dd>
                
                <dt class="col-sm-3">Article</dt>
                <dd class="col-sm-9">@Model.Article?.Name</dd>
                
                <dt class="col-sm-3">Warranty Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Article != null && Model.Article.IsUnderWarranty())
                    {
                        <span class="badge bg-success">Under Warranty</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Out of Warranty</span>
                    }
                </dd>
                
                <dt class="col-sm-3">Interventions</dt>
                <dd class="col-sm-9">
                    @if (Model.Interventions != null && Model.Interventions.Any())
                    {
                        <span class="badge bg-warning">@Model.Interventions.Count intervention(s) will be deleted</span>
                    }
                    else
                    {
                        <span>No interventions</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
    
    <form method="post" action="@Url.Action("Delete", "Admin")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

